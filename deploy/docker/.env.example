# Salin ke .env di folder ini (deploy/docker/.env) lalu isi. Jangan di-commit.

# WAJIB: string acak panjang. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Port di server untuk sistem baru (nginx AirNav akan diarahkan ke sini). Cek dulu: sudo ss -tlnp | grep 8080
NOTAM_PORT=8080
# Antarmuka tempat port dibuka. 0.0.0.0 = semua; isi IP internal server bila ingin dibatasi.
NOTAM_BIND=0.0.0.0

# LLM di server GPU (container notam-ft-ollama). Default: lewat tunnel SSH (container llm-tunnel).
# Bila AirNav membuka rute langsung, ganti ke http://10.168.219.3:11436 dan boleh matikan llm-tunnel.
OLLAMA_URL=http://llm-tunnel:11436
GPU_PUBLIC_IP=103.67.43.166
GPU_SSH_PORT=5617
GPU_OLLAMA_HOST=10.168.219.3
LLM_MODEL=notam-ft
OLLAMA_KEEP_ALIVE=24h
LLM_CONCURRENCY=4

# Bila CPU server tidak mendukung AVX dan mongo:7 gagal start, pakai mongo:4.4
# MONGO_IMAGE=mongo:7
