# Salin ke .env lalu isi: cp .env.example .env
# Dimuat otomatis oleh `npm start` dan `npm run seed` (Node 22.9+).

# --- Wajib ---
MONGO_URI=mongodb://localhost:27017/notam
# String acak panjang, mis. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Kata sandi akun awal untuk `npm run seed`
SEED_PASSWORD=

# --- Opsional ---
PORT=3000

# LLM: mock (default, sengaja gagal validasi) | ollama | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# Hanya bila LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Antarmuka tempat backend mendengarkan. Isi IP tunnel (Tailscale) agar tidak terbuka ke jaringan lain.
# HOST=100.x.y.z
# Jumlah generate LLM yang berjalan bersamaan (sisanya antre, maksimal 10)
# LLM_CONCURRENCY=2
# Lama model Ollama bertahan di memori setelah dipakai (juga untuk tombol Muat model)
# OLLAMA_KEEP_ALIVE=10m
