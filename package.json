{
  "name": "notam-ai-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "jest && npm run test:e2e",
    "test:e2e": "ts-node --transpile-only test/run.ts",
    "build:web": "vite build",
    "build:all": "npm run build:web && npm run build",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "create-user": "node --env-file-if-exists=.env dist/create-user.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "import:dataset": "node --env-file-if-exists=.env dist/import-dataset.js",
    "dev:web": "vite",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
